# =============================================================
# Postgres — use Neon, Supabase, or local docker
# =============================================================
DATABASE_URL="postgresql://user:pass@localhost:5432/account_manager?schema=public"

# =============================================================
# Auth.js
# =============================================================
# Generate with: `openssl rand -base64 32`
AUTH_SECRET=""
# Local dev: http://localhost:3000 . Production: your domain.
AUTH_URL="http://localhost:3000"

# Google OAuth — https://console.cloud.google.com → OAuth client (Web)
# Redirect URI: {AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# =============================================================
# Crypto for storing user access tokens (LinkedIn / Telegram)
# Generate with: `openssl rand -base64 48`
# =============================================================
ENCRYPTION_KEY=""

# =============================================================
# LinkedIn — https://developer.linkedin.com
# Add products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Redirect URI: {AUTH_URL}/api/linkedin/callback
# =============================================================
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# =============================================================
# Telegram — https://t.me/BotFather → /newbot
# =============================================================
TELEGRAM_BOT_TOKEN=""

# =============================================================
# Claude API — https://console.anthropic.com
# =============================================================
ANTHROPIC_API_KEY=""

# =============================================================
# Cron — protects /api/cron/tick (Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}`)
# Generate with: `openssl rand -base64 32`
# =============================================================
CRON_SECRET=""

# =============================================================
# News sourcing (optional)
# Template topics use curated RSS feeds. Custom topics are keyword-searched:
# if NEWSAPI_KEY is set we use NewsAPI (cleaner data), otherwise we fall back
# to Google News RSS search (no key required). Either way, articles from
# low-trust sources are cross-checked against other outlets before publishing.
# =============================================================
NEWSAPI_KEY=""
