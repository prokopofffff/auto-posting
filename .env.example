# =============================================================
# Supabase — https://supabase.com/dashboard → Project Settings → API
# =============================================================
# Project URL + anon (publishable) key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# Service-role (secret) key — server-only, bypasses RLS. NEVER expose to browser.
SUPABASE_SERVICE_ROLE_KEY=""

# =============================================================
# Postgres connection strings — migrations / `supabase` CLI only.
# (The running app talks to Postgres via supabase-js, not these URLs.)
# Project Settings → Database → Connection string.
# =============================================================
# Pooled connection (PgBouncer, port 6543) — use for serverless / transient work.
DATABASE_URL="postgresql://postgres.your-project:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection (port 5432) — required for `supabase db push` / migrations.
DIRECT_URL="postgresql://postgres.your-project:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# =============================================================
# App origin
# =============================================================
# Fallback public origin when forwarded headers are absent (local/edge).
# Used to build absolute OAuth redirect URIs. Local: http://localhost:3000.
AUTH_URL="http://localhost:3000"

# Google sign-in is handled by Supabase Auth — configure the Google OAuth client
# in the Supabase dashboard (Authentication → Providers → Google), NOT here.
# Redirect URL to register with Google: {SUPABASE_URL}/auth/v1/callback

# =============================================================
# Crypto for storing user access tokens (LinkedIn / Telegram)
# Generate with: `openssl rand -base64 48`
# Also doubles as the HMAC key for LinkedIn OAuth signed-state (CSRF).
# =============================================================
ENCRYPTION_KEY=""
# HMAC secret for LinkedIn OAuth state signing. Generate: `openssl rand -base64 32`
AUTH_SECRET=""

# =============================================================
# LinkedIn — https://developer.linkedin.com
# Add products: "Sign In with LinkedIn using OpenID Connect" + "Share on LinkedIn"
# Redirect URI: {AUTH_URL}/api/linkedin/callback
# =============================================================
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""

# =============================================================
# Telegram — https://t.me/BotFather → /newbot
# =============================================================
TELEGRAM_BOT_TOKEN=""

# =============================================================
# Claude API — https://console.anthropic.com
# =============================================================
ANTHROPIC_API_KEY=""

# =============================================================
# Cron — protects /api/cron/tick. Supabase pg_cron + pg_net invokes the tick on
# schedule and sends `Authorization: Bearer ${CRON_SECRET}`. This secret must
# also be stored as a Supabase secret so the pg_cron job can read it.
# Generate with: `openssl rand -base64 32`
# =============================================================
CRON_SECRET=""

# =============================================================
# News sourcing (optional)
# Template topics use curated RSS feeds. Custom topics are keyword-searched:
# if NEWSAPI_KEY is set we use NewsAPI (cleaner data), otherwise we fall back
# to Google News RSS search (no key required). Either way, articles from
# low-trust sources are cross-checked against other outlets before publishing.
# =============================================================
NEWSAPI_KEY=""
